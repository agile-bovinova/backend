# =============================================================================
# BOVINOVA - VACAPP PLATFORM (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BASE DE DATOS (PostgreSQL por defecto)
# -----------------------------------------------------------------------------
DB_PROVIDER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vacapp
DB_USER=root
DB_PASS=root

# Opciones para MySQL (solo si cambias DB_PROVIDER=mysql):
# DB_SSL_MODE=none
# DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# -----------------------------------------------------------------------------
# 2. SEGURIDAD Y AUTENTICACIÓN (JWT)
# -----------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_bovinova_vacapp_2026_safe_key_12345

# -----------------------------------------------------------------------------
# 3. TELEMETRÍA IOT / BROKER MQTT (Collares Biométricos de Ganado)
# -----------------------------------------------------------------------------
# El collar IoT (ESP32 físico o simulador en Python) publica lecturas al Broker MQTT.
# El backend escucha en segundo plano este broker para guardar ritmo cardíaco y temperatura.
# Si no tienes un broker MQTT instalado, el backend igual funciona y reintenta en segundo plano sin caerse.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TELEMETRY_TOPIC=vacapp/telemetry
MQTT_RESPONSE_TOPIC_PREFIX=vacapp/telemetry/response

# -----------------------------------------------------------------------------
# 4. INTELIGENCIA ARTIFICIAL (Asesor Clínico de Tratamiento con LLM)
# -----------------------------------------------------------------------------
# Opcional: Clave de Google Gemini (generada gratis en Google AI Studio).
# Si no se configura o no hay internet, el sistema activa automáticamente su motor
# clínico local inteligente cruzando el inventario sin caerse.
GEMINI_API_KEY=
